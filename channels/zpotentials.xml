            <enclosure url="https://mmbiz.qpic.cn/sz_mmbiz_jpg/f95SMEAicvFuusYuHBdoibpJYsg44zDR1HPknxBXZo6dwudNg4sicYrEKduUQTQMaT2JoyNribEwLo9H88YyK58HSe39Djbm7ibAwiaWdS8Kt5iaMs/0" length="0" type="image//sz_mmbiz_jpg/f95SMEAicvFuusYuHBdoibpJYsg44zDR1HPknxBXZo6dwudNg4sicYrEKduUQTQMaT2JoyNribEwLo9H88YyK58HSe39Djbm7ibAwiaWdS8Kt5iaMs/0"/>
